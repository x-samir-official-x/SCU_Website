{
  "name": "faculty-activity-portal",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n api,web \"tsx watch server/index.ts\" \"vite --host 0.0.0.0\"",
    "build": "tsc --noEmit && vite build",
    "build:preview": "tsc --noEmit && vite build --mode preview --outDir dist-preview",
    "preview:static": "vite preview --outDir dist-preview --host 0.0.0.0 --port 4173",
    "start": "cross-env NODE_ENV=production tsx server/index.ts",
    "dev:demo": "cross-env DEMO_MODE=true npm run dev",
    "start:demo": "cross-env DEMO_MODE=true COOKIE_SECURE=false npm start",
    "test": "tsx --test tests/*.test.ts",
    "typecheck": "tsc --noEmit",
    "test:browser": "tsx tests/browser.smoke.ts",
    "test:preview": "tsx tests/preview.smoke.ts",
    "test:gallery": "tsx tests/gallery.smoke.ts"
  },
  "dependencies": {
    "cross-env": "^10.1.0",
    "express": "^5.1.0",
    "express-rate-limit": "^8.1.0",
    "helmet": "^8.1.0",
    "lucide-react": "^0.468.0",
    "multer": "^2.0.2",
    "playwright-core": "^1.56.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-router-dom": "^7.9.4",
    "tsx": "^4.20.6",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@types/express": "^5.0.3",
    "@types/multer": "^2.0.0",
    "@types/node": "^24.9.1",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.2",
    "@vitejs/plugin-react": "^5.0.4",
    "concurrently": "^9.2.1",
    "prettier": "^3.9.10",
    "typescript": "^5.9.3",
    "vite": "^7.1.12"
  },
  "engines": {
    "node": ">=24.0.0"
  }
}
