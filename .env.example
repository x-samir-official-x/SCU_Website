# Development only. Demo accounts use synthetic data and must not be enabled for real students.
DEMO_MODE=true
PORT=3001
DATA_DIR=.data
CHROMIUM_PATH=/usr/bin/chromium
# In production the session cookie is Secure by default. Set false ONLY to test over plain http.
COOKIE_SECURE=false
# Behind a reverse proxy/platform (Nginx, Railway, Render...): number of proxy hops, usually 1.
# Without it all visitors share one IP and rate limits misbehave.
TRUST_PROXY=
# First-run admin for a real (non-demo) install. Password >= 12 chars; set it in the host's env, never commit it.
ADMIN_NAME=
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Optional email (verification + notification emails). Leave empty to keep email disabled. See docs/EMAIL.md
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM=
# Public site URL used in email links, e.g. https://athar.example.edu.eg
APP_ORIGIN=
